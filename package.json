{
    "name": "@shipstation/shipstation-js-sdk",
    "version": "1.1.3",
    "description": "openapi-generator PoC for TS",
    "keywords": [
        "shipstation",
        "shipping",
        "labels",
        "rates",
        "js",
        "api",
        "sdk",
        "ts"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shipstation/shipstation-js-sdk.git"
    },
    "homepage": "https://github.com/shipstation/shipstation-js-sdk#readme",
    "bugs": {
        "url": "https://github.com/shipstation/shipstation-js-sdk/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "API-CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22.22.2"
    },
    "scripts": {
        "codegen": "./scripts/generate.sh",
        "build": "npm run clean && tsup",
        "clean": "rm -rf dist coverage",
        "typecheck": "tsc --noEmit",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "format:check": "prettier --check .",
        "verify": "npm run lint && npm run format:check && npm run build",
        "prepack": "npm run build",
        "release": "semantic-release"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@types/node": "^22.10.5",
        "conventional-changelog-conventionalcommits": "^9.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "prettier": "^3.4.2",
        "semantic-release": "^25.0.9",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2"
    }
}
